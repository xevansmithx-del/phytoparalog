include CHANGELOG.md CITATION.cff CODE_OF_CONDUCT.md CONTRIBUTING.md LICENSE NOTICE README.md SECURITY.md
include .pre-commit-config.yaml pyproject.toml uv.lock
recursive-include .github *
recursive-include docs *.md
recursive-include examples *.json *.md
recursive-include scripts *.py
recursive-include src *.json *.py *.yaml
recursive-include tests *.py
global-exclude __pycache__ *.py[cod] .DS_Store
