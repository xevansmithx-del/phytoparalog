[
  {
    "name": "PhytoParalog_preflight",
    "type": "PhytoParalogTool",
    "description": "Validate a receipt-bound PhytoParalog study before compilation. Returns schema and aggregate structure only; it does not infer function, rank genes, close evidence gates, or select a target. Includes a packaged synthetic setup fixture.",
    "phytoparalog_operation": "preflight",
    "parameter": {
      "type": "object",
      "additionalProperties": true,
      "description": "Transport-permissive by design: PhytoParalogTool performs closed key and type validation so every failure uses the declared adapter error envelope.",
      "properties": {
        "study": {
          "description": "Complete phytoparalog.study.v0.1 object. Supply this or fixture_id, never both. The core enforces a closed nested schema and receipt relations."
        },
        "fixture_id": {
          "description": "Packaged setup fixture. The only valid value is 'synthetic-minimal-v1'. Supply this or study, never both."
        }
      }
    },
    "test_examples": [
      {
        "fixture_id": "synthetic-minimal-v1"
      }
    ],
    "return_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "competitive_member_count",
        "equivalence_class_count",
        "family_member_count",
        "member_count",
        "observation_count",
        "schema_version",
        "study_id",
        "transcript_count",
        "validated"
      ],
      "properties": {
        "authority": {
          "const": "INPUT_VALIDATION_ONLY"
        },
        "competitive_member_count": {
          "type": "integer",
          "minimum": 2
        },
        "equivalence_class_count": {
          "type": "integer",
          "minimum": 0
        },
        "family_member_count": {
          "type": "integer",
          "minimum": 2
        },
        "member_count": {
          "type": "integer",
          "minimum": 2
        },
        "observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "schema_version": {
          "const": "phytoparalog.study.v0.1"
        },
        "study_id": {
          "type": "string",
          "minLength": 1
        },
        "transcript_count": {
          "type": "integer",
          "minimum": 2
        },
        "validated": {
          "const": true
        }
      }
    }
  },
  {
    "name": "PhytoParalog_compile",
    "type": "PhytoParalogTool",
    "description": "Compile a validated PhytoParalog study in memory. Returns fail-closed producer status, hold reasons, schema versions, and canonical document digests; it writes no files or memory and never ranks or selects a biological target.",
    "phytoparalog_operation": "compile",
    "parameter": {
      "type": "object",
      "additionalProperties": true,
      "description": "Transport-permissive by design: PhytoParalogTool performs closed key and type validation so every failure uses the declared adapter error envelope.",
      "properties": {
        "study": {
          "description": "Complete phytoparalog.study.v0.1 object. Supply this or fixture_id, never both. The core enforces a closed nested schema and receipt relations."
        },
        "fixture_id": {
          "description": "Packaged setup fixture. The only valid value is 'synthetic-minimal-v1'. Supply this or study, never both."
        }
      }
    },
    "test_examples": [
      {
        "fixture_id": "synthetic-minimal-v1"
      }
    ],
    "return_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "core_version",
        "document_sha256",
        "hold_reasons",
        "producer_status",
        "schema_versions",
        "study_id"
      ],
      "properties": {
        "authority": {
          "const": "IDENTIFIABILITY_EVIDENCE_ONLY"
        },
        "core_version": {
          "type": "string",
          "minLength": 1
        },
        "document_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifiability.json",
            "pec_candidate_evidence.json",
            "phytoresolve_proposed_events.json",
            "study_lock.json"
          ],
          "properties": {
            "identifiability.json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pec_candidate_evidence.json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "phytoresolve_proposed_events.json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "study_lock.json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "hold_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "producer_status": {
          "type": "string",
          "enum": [
            "COMPILED_FOR_INDEPENDENT_REVIEW",
            "HOLD",
            "INVALID"
          ]
        },
        "schema_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifiability.json",
            "pec_candidate_evidence.json",
            "phytoresolve_proposed_events.json",
            "study_lock.json"
          ],
          "properties": {
            "identifiability.json": {
              "type": "string"
            },
            "pec_candidate_evidence.json": {
              "type": "string"
            },
            "phytoresolve_proposed_events.json": {
              "type": "string"
            },
            "study_lock.json": {
              "type": "string"
            }
          }
        },
        "study_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  {
    "name": "PhytoParalog_validate_capsule",
    "type": "PhytoParalogTool",
    "description": "Validate a five-file PhytoParalog capsule against exactly one trusted anchor: its original study or external digest. Returns the validation mode; unanchored self-consistency is rejected and no scientific gate or target is selected.",
    "phytoparalog_operation": "validate_capsule",
    "parameter": {
      "type": "object",
      "additionalProperties": true,
      "description": "Transport-permissive by design: PhytoParalogTool performs closed key, type, and digest validation so every failure uses the declared adapter error envelope.",
      "properties": {
        "capsule_dir": {
          "description": "Local five-file capsule directory. Supply with exactly one of study or expected_capsule_digest, or use fixture_id alone."
        },
        "study": {
          "description": "Original complete phytoparalog.study.v0.1 object used for full byte recomputation. Supply with capsule_dir, never with another anchor."
        },
        "expected_capsule_digest": {
          "description": "Externally stored capsule digest. Supply with capsule_dir instead of study; the capsule's own manifest is not an external anchor."
        },
        "fixture_id": {
          "description": "Packaged setup fixture. The only valid value is 'synthetic-minimal-v1'. It is compiled and fully study-recomputed; supply no other field."
        }
      }
    },
    "test_examples": [
      {
        "fixture_id": "synthetic-minimal-v1"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capsule_digest",
            "capsule_valid",
            "capsule_semantics_trusted",
            "core_version",
            "document_count",
            "hold_reasons",
            "producer_status",
            "validation_authority",
            "validation_mode"
          ],
          "properties": {
            "capsule_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "capsule_valid": {
              "const": true
            },
            "capsule_semantics_trusted": {
              "const": true
            },
            "core_version": {
              "type": "string",
              "minLength": 1
            },
            "document_count": {
              "const": 5
            },
            "hold_reasons": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "producer_status": {
              "type": "string",
              "enum": [
                "COMPILED_FOR_INDEPENDENT_REVIEW",
                "HOLD",
                "INVALID"
              ]
            },
            "validation_authority": {
              "const": "STUDY_RECOMPUTED_STRUCTURE_AND_SEMANTICS"
            },
            "validation_mode": {
              "const": "STUDY_RECOMPUTED"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capsule_digest",
            "capsule_valid",
            "capsule_semantics_trusted",
            "core_version",
            "document_count",
            "validation_authority",
            "validation_mode"
          ],
          "properties": {
            "capsule_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "capsule_valid": {
              "const": true
            },
            "capsule_semantics_trusted": {
              "const": false
            },
            "core_version": {
              "type": "string",
              "minLength": 1
            },
            "document_count": {
              "const": 5
            },
            "validation_authority": {
              "const": "EXTERNALLY_ANCHORED_INTEGRITY_ONLY"
            },
            "validation_mode": {
              "const": "EXTERNAL_DIGEST_ANCHORED"
            }
          }
        }
      ]
    }
  }
]
